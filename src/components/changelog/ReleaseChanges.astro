---
// A release's technical changes, grouped by category. Rendered on its own
// when a release has no user-facing note, or inside the "Technical changes"
// disclosure when it does. Per gspec/features/changelog-page.md §4.

import {
  renderInlineMarkdown,
  splitChange,
  CHANGELOG_CATEGORIES,
  type ChangeEntry,
} from '../../lib/changelog';

interface Props {
  changes: ChangeEntry[];
}

const { changes } = Astro.props;

// Group changes by category, in the canonical Keep-a-Changelog order.
const categories = CHANGELOG_CATEGORIES.map((cat) => ({
  cat,
  items: changes.filter((c) => c.category === cat).map((c) => c.text),
})).filter(({ items }) => items.length > 0);
---

{
  categories.map(({ cat, items }) => (
    <section class="release-category">
      <h3 class={`release-category-label release-category-${cat.toLowerCase()}`}>{cat}</h3>
      <ul>
        {items.map((text) => {
          // Terse summary; the full entry stays one click away.
          const { summary, detail } = splitChange(text);
          return detail ? (
            <li class="has-detail">
              <details>
                <summary set:html={renderInlineMarkdown(summary)} />
                <p class="release-detail" set:html={renderInlineMarkdown(detail)} />
              </details>
            </li>
          ) : (
            <li set:html={renderInlineMarkdown(summary)} />
          );
        })}
      </ul>
    </section>
  ))
}

<style>
  .release-category {
    margin-bottom: 1.75rem;
  }

  .release-category:last-child {
    margin-bottom: 0;
  }

  .release-category-label {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    background: var(--elevated);
  }

  .release-category-added {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .release-category-changed {
    color: var(--accent-alt);
    background: color-mix(in srgb, var(--accent-alt) 12%, transparent);
  }

  .release-category-fixed,
  .release-category-deprecated {
    color: var(--warn);
    background: color-mix(in srgb, var(--warn) 14%, transparent);
  }

  .release-category-removed,
  .release-category-security {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 12%, transparent);
  }

  .release-category ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .release-category li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* Small dot marker for plain bullets; expandable ones get a chevron. */
  .release-category li:not(.has-detail)::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.65em;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .release-category summary {
    list-style: none;
    cursor: pointer;
  }

  .release-category summary::-webkit-details-marker {
    display: none;
  }

  .release-category summary::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.55em;
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid var(--fg-faint);
    border-bottom: 1.5px solid var(--fg-faint);
    transform: rotate(-45deg);
    transition: transform 120ms ease;
  }

  .release-category details[open] > summary::before {
    transform: rotate(45deg);
  }

  .release-category summary:hover,
  .release-category summary:hover::before {
    color: var(--accent);
    border-color: var(--accent);
  }

  .release-category summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .release-detail {
    margin: 0.25rem 0 0.625rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .release-category li :global(strong) {
    font-weight: 600;
  }

  .release-category li :global(a) {
    color: var(--accent);
  }

  /* Inline code in release notes — uses the same chip style as docs. */
  .release-category li :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125em;
    background: var(--elevated);
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--radius-sm);
    color: var(--fg);
    border: 1px solid var(--border);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
