---
// One release entry. Per gspec/features/changelog-page.md §4 P0.
//
// Leads with the hand-written, user-facing note from
// src/config/release-notes.ts; the technical changes from CHANGELOG.md sit
// behind a disclosure. Releases without a note show the technical changes
// directly.

import type { ChangelogEntry } from '../../lib/changelog';
import { renderInlineMarkdown } from '../../lib/changelog';
import { releaseNotes } from '../../config/release-notes';
import ReleaseChanges from './ReleaseChanges.astro';

interface Props {
  release: ChangelogEntry;
}

const { release } = Astro.props;
const note = releaseNotes[release.version];

if (!note) {
  console.warn(
    `[changelog] No user-facing note for ${release.version} in src/config/release-notes.ts; ` +
      `showing its technical changes instead.`,
  );
}
---

<article class={`release release-${release.releaseType}`}>
  <header class="release-header">
    <h2 id={release.anchorId}>
      <a class="release-anchor" href={`#${release.anchorId}`} aria-label={`Copy link to ${release.version}`}>
        <span class="release-version">{release.version}</span>
        <span class="release-anchor-mark" aria-hidden="true">#</span>
      </a>
      <span class={`release-badge release-badge-${release.releaseType}`}>
        {release.releaseType}
      </span>
    </h2>
    <time datetime={release.date} class="release-date">
      {release.date}
    </time>
  </header>

  {
    note ? (
      <>
        <p class="release-summary" set:html={renderInlineMarkdown(note.summary)} />
        <ul class="release-highlights">
          {note.highlights.map((h) => <li set:html={renderInlineMarkdown(h)} />)}
        </ul>
        {release.changes.length > 0 && (
          <details class="release-technical">
            <summary>Technical changes ({release.changes.length})</summary>
            <div class="release-technical-body">
              <ReleaseChanges changes={release.changes} />
            </div>
          </details>
        )}
      </>
    ) : (
      <ReleaseChanges changes={release.changes} />
    )
  }
</article>

<style>
  .release {
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 5rem;
  }

  .release:last-child {
    border-bottom: none;
  }

  .release-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .release h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .release-anchor {
    color: var(--fg);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .release-anchor:hover {
    text-decoration: none;
    color: var(--fg);
  }

  .release-anchor-mark {
    color: var(--fg-faint);
    font-weight: 400;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .release-anchor:hover .release-anchor-mark,
  .release-anchor:focus-visible .release-anchor-mark {
    opacity: 1;
    color: var(--accent);
  }

  .release-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    background: var(--elevated);
  }

  .release-badge-major {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .release-badge-minor {
    color: var(--accent-alt);
    border-color: var(--accent-alt);
    background: color-mix(in srgb, var(--accent-alt) 10%, transparent);
  }

  .release-date {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .release-summary {
    margin: 0 0 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg);
    max-width: 42rem;
  }

  .release-highlights {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .release-highlights li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 42rem;
  }

  .release-highlights li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.62em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .release-highlights li :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125em;
    background: var(--elevated);
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--radius-sm);
    color: var(--fg);
    border: 1px solid var(--border);
  }

  .release-technical > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }

  .release-technical > summary::-webkit-details-marker {
    display: none;
  }

  .release-technical > summary::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 120ms ease;
  }

  .release-technical[open] > summary::before {
    transform: rotate(45deg);
  }

  .release-technical > summary:hover {
    color: var(--accent);
  }

  .release-technical > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .release-technical-body {
    margin-top: 1.25rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }
</style>
